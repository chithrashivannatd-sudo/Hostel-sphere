{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HostelSphere: Run Server (F5)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "127.0.0.1:8000",
                "--noreload"
            ],
            "django": true,
            "justMyCode": false,
            "env": {
                "USE_SQLITE": "1",
                "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/HOSTELSPHERE"
            }
        }
    ]
}

