{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Django development server",
            "type": "shell",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "manage.py",
                "runserver",
                "127.0.0.1:8000"
            ],
            "options": {
                "env": {
                    "USE_SQLITE": "1",
                    "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/HOSTELSPHERE"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
