# ==============================================================================
# HostelSphere Environment Configuration Template
# Copy this file to .env and customize the values for your environment.
# ==============================================================================

# Django Core Settings
DEBUG=1
SECRET_KEY=dev-secret-key-change-me-in-production
PYTHONPATH=HOSTELSPHERE

# Database Configuration
# Set USE_SQLITE=1 for SQLite (default for development), or 0 for MySQL
USE_SQLITE=1

# MySQL Configuration (Required when USE_SQLITE=0)
DB_NAME=hostel_sphere
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

